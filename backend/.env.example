# ==============================================================================
# 3-Tier Todo App - Backend Environment Configuration
# ==============================================================================

# PostgreSQL Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todo_db

# Alternative individual connection settings (used if DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=todo_db

# Allowed CORS Origins for Frontend (comma-separated list)
# Default ports: 3000 (standard React/Vite in this project), 5173 (standard Vite)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# FastAPI Server Host and Port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
